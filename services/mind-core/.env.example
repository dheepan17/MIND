# mind-core service environment example (placeholders only, no real credentials).
# Copy to .env and replace YOUR_PASSWORD. .env is gitignored.

# Application database (used by the running service / migrations).
DATABASE_URL=postgresql://mind_app:YOUR_PASSWORD@localhost:5432/mind_db

# Isolated database used only by the test suite (mind_test_db).
# Application code never reads this; tests pass it explicitly.
TEST_DATABASE_URL=postgresql://mind_app:YOUR_PASSWORD@localhost:5432/mind_test_db